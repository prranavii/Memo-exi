# MEMO-EXI Configuration

# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Storage Paths
SQLITE_DB_PATH=./data/memo_exi.db
CHROMA_PERSIST_DIR=./data/chroma_storage
CHROMA_COLLECTION_NAME=memo_exi_vectors

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Context Budget & Retrieval Defaults
DEFAULT_TOKEN_BUDGET=1024
DEFAULT_TOP_K=5
MAX_TOP_K=15

# Controller Weights for Memory Utility Scoring
WEIGHT_RELEVANCE=0.45
WEIGHT_TEMPORAL=0.25
WEIGHT_IMPORTANCE=0.20
WEIGHT_REDUNDANCY=0.10

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
